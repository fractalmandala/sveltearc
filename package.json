{
	"name": "sveltearc",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"check:port": "node scripts/check-port.mjs",
		"lint:agent": "node scripts/cui-lint.mjs",
		"lint:agent:json": "node scripts/cui-lint.mjs --json"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"fractalpop": "^0.2.0",
		"sass": "^1.105.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16"
	},
	"dependencies": {
		"@humanspeak/svelte-motion": "^1.5.0",
		"@lucide/svelte": "^1.49.0",
		"bits-ui": "^2.19.3",
		"marked": "^18.0.14"
	}
}
