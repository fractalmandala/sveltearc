{
	"name": "sveltearc",
	"version": "0.1.0",
	"description": "A Svelte 5 + SvelteKit component library ported from Arc — headless Bits UI primitives, verbatim CSS modules, and a shared motion language.",
	"type": "module",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/fractalmandala/sveltearc.git"
	},
	"homepage": "https://sveltearc.fractalsvelte.dev",
	"keywords": [
		"svelte",
		"sveltekit",
		"components",
		"ui",
		"bits-ui",
		"design-system"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./foundation.css": "./dist/foundation.css",
		"./motion-tokens": {
			"types": "./dist/motion-tokens.d.ts",
			"default": "./dist/motion-tokens.js"
		},
		"./media": {
			"types": "./dist/media.d.ts",
			"default": "./dist/media.js"
		}
	},
	"files": [
		"dist",
		"!dist/**/*.manifest.json",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"sideEffects": [
		"**/*.css"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"check:port": "node scripts/check-port.mjs",
		"barrel": "node scripts/gen-barrel.mjs",
		"lint:agent": "node scripts/cui-lint.mjs",
		"lint:agent:json": "node scripts/cui-lint.mjs --json",
		"package": "svelte-package",
		"prepublishOnly": "svelte-package"
	},
	"peerDependencies": {
		"@humanspeak/svelte-motion": "^1.5.0",
		"@lucide/svelte": "^1.49.0",
		"bits-ui": "^2.19.3",
		"svelte": "^5.0.0"
	},
  "dependencies": {
    "@fractalpop/svelte": "^0.1.0",
    "fractalpop": "^0.1.0"
  },
	"devDependencies": {
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/adapter-vercel": "^6.3.4",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/package": "^2.5.8",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"fractalpop": "^0.2.0",
    "@fractalpop/mdsvex": "^0.1.0",
    "@fractalpop/remark": "^0.1.0",
		"marked": "^18.0.14",
		"sass": "^1.105.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16"
	}
}
